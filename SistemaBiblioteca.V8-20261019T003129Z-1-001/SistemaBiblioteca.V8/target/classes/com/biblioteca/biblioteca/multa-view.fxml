<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.biblioteca.controller.MultaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gerenciamento de Multas" />

    <!-- Formulário para Inserir/Editar Multa -->
    <GridPane hgap="10" vgap="10">
        <Label text="Empréstimo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="cbEmprestimo" prefWidth="350" promptText="Selecione o empréstimo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Valor (R$):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtValor" prefWidth="150" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Status Pagamento:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cbStatusPagamento" prefWidth="200" promptText="Selecione o status" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <!-- Botões de Ação CRUD -->
    <HBox spacing="10">
        <Button onAction="#onSalvarClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Salvar Multa" />
        <Button onAction="#onExcluirClick" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Excluir Selecionada" />
        <Button onAction="#onLimparClick" text="Limpar Campos" />
    </HBox>

    <Separator />

    <!-- Tabela para Listar as Multas -->
    <TableView fx:id="tabelaMultas" prefHeight="250.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colEmprestimo" prefWidth="280.0" text="Empréstimo (Usuário - Livro)" />
            <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor (R$)" />
            <TableColumn fx:id="colStatusPagamento" prefWidth="130.0" text="Situação" />
        </columns>
    </TableView>
</VBox>