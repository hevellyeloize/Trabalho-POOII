<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.biblioteca.controller.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gerenciamento de Livros" />

    <GridPane hgap="10" vgap="10">
        <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtTitulo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Autor:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtAutor" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Ano:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtAno" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Quantidade:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtQuantidade" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <HBox spacing="10">
        <Button onAction="#onSalvarClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Salvar Livro" />
        <Button onAction="#onExcluirClick" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Excluir Selecionado" />
        <Button onAction="#onLimparClick" text="Limpar Campos" />
    </HBox>

    <Separator />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Pesquisar (Título/Autor):" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtBusca" promptText="Digite para filtrar..." prefWidth="300" />
    </HBox>

    <TableView fx:id="tabelaLivros" prefHeight="220.0" prefWidth="500.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colTitulo" prefWidth="180.0" text="Título" />
            <TableColumn fx:id="colAutor" prefWidth="150.0" text="Autor" />
            <TableColumn fx:id="colAno" prefWidth="60.0" text="Ano" />
            <TableColumn fx:id="colQuantidade" prefWidth="80.0" text="Qtd" />
        </columns>
    </TableView>
</VBox>